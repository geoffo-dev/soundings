# Keep the build context small and free of local state. The Dockerfile only needs
# backend/{pyproject.toml,uv.lock,README.md,app} and frontend sources.
**

!backend/pyproject.toml
!backend/uv.lock
!backend/README.md
!backend/app/
!scripts/precompress-assets.mjs

!frontend/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Anywhere inside the allowed paths
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.tsbuildinfo
**/.env
**/.env.*
**/.DS_Store
