{
  "name": "soundings-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright end-to-end tests against the real Soundings stack (API + built SPA + Postgres).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "playwright test",
    "screenshots": "SCREENSHOTS=phase-1 playwright test --project=screenshots",
    "screenshots:phase2": "SCREENSHOTS=phase-2 E2E_SSO=1 playwright test --project=screenshots && SCREENSHOTS=phase-2 E2E_SSO=0 playwright test --project=screenshots --grep @break-glass",
    "screenshots:phase3": "SCREENSHOTS=phase-3 playwright test --project=screenshots && SCREENSHOTS=phase-3 E2E_SMTP=0 playwright test --project=screenshots --grep @no-smtp",
    "screenshots:phase4": "SCREENSHOTS=phase-4 playwright test --project=screenshots",
    "screenshots:phase5": "SCREENSHOTS=phase-5 playwright test --project=screenshots",
    "screenshots:phase6": "SCREENSHOTS=phase-6 E2E_AI=1 playwright test --project=screenshots",
    "screenshots:phase8": "SCREENSHOTS=phase-8 playwright test --project=screenshots",
    "screenshots:phase8b": "SCREENSHOTS=phase-8b playwright test --project=screenshots",
    "screenshots:tour": "SCREENSHOTS=tour E2E_SSO=1 E2E_AI=1 playwright test --project=screenshots",
    "stack:start": "scripts/start-stack.sh",
    "stack:stop": "scripts/stop-stack.sh",
    "stack:reseed": "scripts/reseed.sh",
    "perf": "playwright test -c perf/playwright.config.ts",
    "perf:stack": "perf/stack.sh up",
    "perf:bundle": "node --experimental-strip-types perf/bundle-report.ts --build",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
