# Local development settings. `cp dev/.env.example dev/.env`, then:
#   - docker compose (make dev-up) reads the ports and images below from dev/.env;
#   - the backend reads SOUNDINGS_* from its environment: `set -a; . dev/.env; set +a`
#     in each shell that runs `make -C backend dev`, `worker`, `migrate` or `make seed`.
# Names and meanings: backend/app/config.py and the chart (deploy/helm/README.md).
# Changed a port? Change the URLs that use it too.

# --- Dev services (docker compose) ----------------------------------------------------
SOUNDINGS_DEV_POSTGRES_PORT=5432
SOUNDINGS_DEV_KEYCLOAK_PORT=8080
SOUNDINGS_DEV_MAILPIT_UI_PORT=8025
SOUNDINGS_DEV_MAILPIT_SMTP_PORT=1025
# Images (point at an internal registry when offline).
# POSTGRES_IMAGE=postgres:16-alpine
# KEYCLOAK_IMAGE=keycloak/keycloak:26.0
# MAILPIT_IMAGE=axllent/mailpit:latest

# --- Backend ----------------------------------------------------------------------------
SOUNDINGS_DATABASE_URL=postgresql+psycopg://soundings:soundings@localhost:5432/soundings
# The API (8000) and the Vite dev server (5173, proxies /api): each signs in on itself.
SOUNDINGS_BASE_URLS=http://localhost:8000,http://localhost:5173
# The "who are you?" picker, next to SSO (development only).
SOUNDINGS_DEV_LOGIN_ENABLED=true

# Single sign-on with the dev Keycloak (realm "soundings", users in dev/README.md).
# The API runs on the host, like your browser, so both use this issuer.
SOUNDINGS_OIDC_ISSUER=http://localhost:8080/realms/soundings
SOUNDINGS_OIDC_CLIENT_ID=soundings
SOUNDINGS_OIDC_CLIENT_SECRET=soundings-dev-secret
SOUNDINGS_OIDC_GROUPS_CLAIM=groups
# An admin-only attribute in the dev realm, as it must be (contract-phase2 section 3.3).
SOUNDINGS_OIDC_EXTERNAL_ID_CLAIM=employee_no
# Defaults: link by verified email on, auto-create off.
# SOUNDINGS_OIDC_MATCH_VERIFIED_EMAIL=true
# SOUNDINGS_OIDC_AUTO_CREATE_USERS=false

# Break-glass admin: works only while SOUNDINGS_OIDC_ISSUER is unset (comment it out to
# try it; sign in on /login with these).
SOUNDINGS_BREAK_GLASS_ENABLED=true
SOUNDINGS_BREAK_GLASS_USERNAME=admin
SOUNDINGS_BREAK_GLASS_PASSWORD=dev-break-glass-password

# Email to Mailpit (Phase 3).
# SOUNDINGS_SMTP_HOST=localhost
# SOUNDINGS_SMTP_PORT=1025
# SOUNDINGS_SMTP_SECURITY=none
# SOUNDINGS_SMTP_FROM=soundings@example.com
