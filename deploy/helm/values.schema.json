{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Soundings Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "description": "Registry for every image in the chart"
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 40
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 50
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
            "maxLength": 253
          }
        }
      },
      "required": [
        "repository",
        "pullPolicy"
      ]
    },
    "baseUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https?://[^/?#\\s]+/?$",
        "description": "scheme://host[:port], no path"
      },
      "uniqueItems": true
    },
    "trustedProxies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(\\*|[0-9A-Fa-f:.]+(/[0-9]{1,3})?)$",
        "description": "IP address, CIDR network or * (everyone)"
      }
    },
    "trustedProxyHops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Trusted proxies that append to X-Forwarded-For (ingress controller: 1)"
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "devLogin": {
      "type": "boolean",
      "description": "Dev-only login stub; switches the app to development mode"
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "boolean",
          "description": "Load demo data after install/upgrade (needs devLogin)"
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleTimeout": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^(P([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?|[0-9]+)$",
          "minimum": 60,
          "description": "ISO 8601 duration (e.g. PT12H) or seconds"
        },
        "maxAge": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^(P([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?|[0-9]+)$",
          "minimum": 60,
          "description": "ISO 8601 duration (e.g. PT24H) or seconds"
        }
      },
      "required": [
        "idleTimeout",
        "maxAge"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "not": {
            "const": 8000
          },
          "description": "Port of /metrics (not the app port 8000)"
        }
      },
      "required": [
        "port"
      ]
    },
    "secretKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(https?://[^\\s?#]+)?$",
          "description": "The provider's issuer URL (no query or fragment); empty: SSO off"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientSecret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "groupsClaim": {
          "type": "string",
          "maxLength": 200,
          "description": "Claim name or dotted path; empty: no group sync"
        },
        "externalIdClaim": {
          "type": "string",
          "maxLength": 200
        },
        "externalIdKind": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{0,39})?$",
          "description": "Lower-case letters, digits and underscores; empty: the claim path's last segment"
        },
        "matchVerifiedEmail": {
          "type": "boolean"
        },
        "autoCreateUsers": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\x21\\x23-\\x5b\\x5d-\\x7e]+$"
          },
          "contains": {
            "const": "openid"
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "Host name or IP address, no scheme or port. Empty: email off (in-app notifications only).",
          "pattern": "^([A-Za-z0-9._-]{1,253}|[0-9A-Fa-f:.]{2,45})?$"
        },
        "port": {
          "description": "SMTP port. Empty: 465 with security tls, else 587.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,4})?$"
            }
          ]
        },
        "security": {
          "type": "string",
          "enum": [
            "none",
            "starttls",
            "tls"
          ]
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "from": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^([A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*)?$",
          "description": "Sender address: one plain address such as soundings@example.com."
        },
        "fromName": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$"
        },
        "replyTo": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^([A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*)?$",
          "description": "Optional Reply-To address (one plain address)."
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "description": "Seconds for the connection and each SMTP command."
        }
      }
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone for digests, reminders and dates in emails, e.g. Europe/London.",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$"
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digestHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "Hour (0-23, in timezone) of daily digests and evaluation reminders."
        },
        "reminderDays": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "description": "Days before the due date for evaluation reminders (0 = on the day). Empty: none."
        }
      }
    },
    "breakGlass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicSubmission": {
          "type": "boolean"
        },
        "ai": {
          "type": "boolean"
        }
      }
    },
    "publicSubmission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perIpPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "perProjectPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "altcha": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cost": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 1000000
            },
            "expiry": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^(P([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?|[0-9]+)$",
              "minimum": 60,
              "maximum": 86400,
              "description": "ISO 8601 duration (e.g. PT30M) or seconds, 1 minute to 1 day"
            }
          },
          "required": [
            "cost",
            "expiry"
          ]
        }
      },
      "required": [
        "perIpPerHour",
        "perProjectPerHour",
        "altcha"
      ]
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxUploadBytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 921600
        }
      },
      "required": [
        "maxUploadBytes"
      ]
    },
    "kagent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "examples": {
          "type": "boolean"
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^(https?://\\S+)?$"
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ]
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "description": "A Kubernetes Probe; {} disables it."
        },
        "livenessProbe": {
          "type": "object",
          "description": "A Kubernetes Probe; {} disables it."
        },
        "readinessProbe": {
          "type": "object",
          "description": "A Kubernetes Probe; {} disables it."
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "topologySpreadConstraints": {
          "type": "array"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "livenessProbe": {
          "type": "object",
          "description": "A Kubernetes Probe; {} disables it."
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "waitForDatabaseSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "claims": {
              "type": "array"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
                "maxLength": 253
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "publicApi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "tmpSizeLimit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": [
                "string",
                "number"
              ]
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "username": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
              "maxLength": 253
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteOncePod",
                  "ReadWriteMany"
                ]
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "minLength": 1
        },
        "sslmode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "smtp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "port": {
                  "description": "Destination port of the SMTP server's pods. Empty: the SMTP port.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "pattern": "^([1-9][0-9]{0,4})?$"
                    }
                  ]
                }
              }
            },
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "port": {
                  "description": "Destination port of the IdP. Empty: the issuer URL's port.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "pattern": "^([1-9][0-9]{0,4})?$"
                    }
                  ]
                }
              }
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))+$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
